using System.Text;
using Grpc.Core;
using Hub.V1;
using @@sdk_module@@;

namespace @@package@@;

/// <summary>
/// @@name@@ 的实现。
///
/// 它用 <c>google.protobuf.Struct</c> 承载 JSON 载荷：agent 经 MCP、外部系统经 HTTP
/// 调用本插件时，中台会把 JSON 对象包成 Struct 送进来，用
/// <see cref="Envelopes.PayloadJson"/> 取。
///
/// 如果需要与其他插件在 flow 里传递**类型化**的业务消息，再加一份自己的 .proto、
/// 用 Grpc.Tools 生成 C# 代码、在 <see cref="Descriptor"/> 里返回它，
/// 并在 manifest 的 Produces 中声明。
/// </summary>
public sealed class Plugin : IPlugin, IStateAware
{
    /// <summary>
    /// 继续处理所需的最小剩余预算。
    ///
    /// 信封带着绝对 deadline 逐跳递减；预算不够时应当提前放弃，让失败快速冒泡，
    /// 而不是把时间耗光后靠上层超时兜底——那样调用方连「为什么慢」都看不出来。
    /// </summary>
    private static readonly TimeSpan MinBudget = TimeSpan.FromMilliseconds(100);

    /// <summary>
    /// 跨调用状态（HubState）的客户端，由宿主在**每次注册成功后**注入。
    ///
    /// 它是 <c>null</c> 就说明这个插件走的是无状态那一路——**用它之前必须判空**。
    /// 本模板已经接好了注入（见 <see cref="SetState"/>），你只要在
    /// <see cref="HandleAsync"/> 里用起来即可。
    ///
    /// <c>volatile</c> 不是装饰：<see cref="SetState"/> 跑在注册循环那个任务上，
    /// 而 handler 通常跑在别的任务上，裸赋值给一个会被其它任务读取的字段就是数据竞争。
    /// </summary>
    private volatile StateClient? _state;

    /// <summary>
    /// 由宿主在注册成功后调用，把状态客户端交进来。
    ///
    /// <para>
    /// <b>什么时候需要它</b>：插件实例**不保证**跨调用保留内存（热切换零代价、
    /// 可水平扩展就是这么来的）。要跨调用保留东西——登录缓存、去重标记、游标、
    /// 限流计数——就得走 HubState。
    /// </para>
    /// <para>
    /// <b>怎么用</b>：在 <see cref="HandleAsync"/> 里 <c>_state</c> 取出来用即可，
    /// **记得判空**：为 null 就说明还没注册上（宿主在注册成功后才注入），这时按
    /// fail-open 处理——拿不到缓存就回源，别让一次状态抖动把业务调用带下水。
    /// </para>
    /// <code>
    /// // 读。found 区分「键不存在」与「值是空字节」
    /// var (value, found) = await _state.GetAsync("sessions", userId, ct);
    /// // 写。ttl 为 TimeSpan.Zero 表示不过期；粒度是**秒**，
    /// // 不足 1 秒会被截断为 0（= 永不过期），想让它过期就传 >= 1s
    /// await _state.PutAsync("sessions", userId, blob, TimeSpan.FromMinutes(30), ct);
    /// // 删。返回它之前是否存在，删不存在的键**不是**错误
    /// var existed = await _state.DeleteAsync("sessions", userId, ct);
    /// // 扫。prefix 传 "" 表示扫整个命名空间；limit 必须在 1..=1000
    /// var entries = await _state.ScanAsync("sessions", "user:", 100, ct);
    /// </code>
    /// <para>
    /// <b>两个必须知道的约束</b>：
    /// </para>
    /// <list type="bullet">
    /// <item><b>命名空间是插件隔离的</b>：中台按注册凭证反查出你的插件名、强制拼进键前缀
    /// （<c>hub:state:{插件名}:{namespace}:{key}</c>），你自报的 namespace 只是前缀下的
    /// **子空间**。所以你只写自己的业务子空间（<c>sessions</c>、<c>cursors</c>），
    /// 既不需要也不应该写插件名。</item>
    /// <item><b>namespace / key / prefix 都只允许 <c>[A-Za-z0-9_.-]</c>、非空、
    /// 最长 200 字节</b>。放行 <c>*</c> 是漏洞不是功能：前缀靠字符串拼接，
    /// 通配符会让 Scan 变成跨命名空间的模式匹配。</item>
    /// </list>
    /// <para>
    /// 宿主在**每次注册成功后**都会再调一次（中台重启、实例被摘除后自愈），注入的是
    /// <b>同一个</b>客户端对象，凭证在它内部轮换——不要把这个引用长期拷进别处。
    /// </para>
    /// <para>
    /// 本地调试时 mock 中台也实现了这一套（键名规则与真中台同源），所以不必连真中台。
    /// </para>
    /// </summary>
    public void SetState(StateClient state) => _state = state;

    /// <summary>
    /// 声明插件的身份、契约与暴露给 agent 的能力。
    ///
    /// **同一版本号的 manifest 不可变更**——中台会拒绝「同号不同契约」的注册，
    /// 改了请升版本号。
    /// </summary>
    public PluginManifest Manifest => new()
    {
        Name = "@@name@@",
        Version = "0.1.0",
        Description = "TODO: 一句话说明这个插件干什么",
        Owner = "TODO: 负责团队",

        // 接受直接调用的 JSON 载荷。它是 well-known 类型，不必出现在自己的 proto 里。
        Consumes = { new MessageContract { FqName = Envelopes.StructFqName } },

        // 暴露给 agent 的能力。它会聚合进中台统一的 MCP 工具面，名字是
        // `插件名__工具名`（跨插件重名不冲突）——注册成功后 agent 拉一次
        // tools/list 就能看见并调用，中台不用重启。
        //
        // 两条仍然成立的限制：**工具面变了不会主动通知已连接的 agent**
        // （`notifications/tools/list_changed` 未实现），所以 agent 要重新拉一次
        // 才看得见；插件实例被摘除后，它的工具也会随之从列表里消失。
        Tools =
        {
            new ToolDecl
            {
                Name = "echo",
                Description = "TODO: 这个工具干什么 —— agent 靠这句描述决定何时调用它",
                InputSchemaJson =
                    """{"type":"object","properties":{"text":{"type":"string","description":"要回显的文本"}},"required":["text"]}""",
            },
        },

        // 可调用的目标插件名（插件互调的权限名单）。**刻意不声明**：中台策略
        // HUB_PLUGIN_CALL_POLICY 为 allow（缺省）时不看这个名单，声明了反而
        // 把自己的调用面收窄；为 declared 时则必须声明，名单外一律拒绝。
        // 真要互调时打开下面这行（并同步升版本号——同版本号的 manifest 不可变更）：
        // Invokes = { "目标插件名" },
    };

    /// <summary>
    /// 本插件的 proto 编译产物，中台据此建立契约基线并做字段级兼容检查。
    ///
    /// 只用 Struct 载荷的插件没有自己的 proto，返回空即可——中台允许空 descriptor，
    /// 只要 manifest 里没声明自有类型。真有自己的 .proto 时这样写：
    /// <code>
    /// public byte[] Descriptor => Descriptors.Of(MyContractReflection.Descriptor);
    /// </code>
    /// </summary>
    public byte[] Descriptor => Descriptors.Of();

    /// <summary>
    /// 数据校验规则。
    ///
    /// 中台在把数据交给 <see cref="HandleAsync"/> 之前**一定**先调用它；
    /// 返回 <c>Valid=false</c> 时链路短路，Handle 不会被调用。
    /// 规则与插件体同版本发布，因此不可能与实现漂移。
    /// </summary>
    public Task<ValidateResponse> ValidateAsync(Envelope envelope, CancellationToken cancellationToken)
    {
        var payload = Envelopes.PayloadJson(envelope);
        if (payload is null)
        {
            return Task.FromResult(Envelopes.Invalid(Envelopes.Issue("payload", "需要 JSON 对象载荷")));
        }

        if (!payload.TryGetValue("text", out var raw) || raw is not string text || text.Length == 0)
        {
            // path 要能定位到具体字段，中台会原样把它回给调用方，agent 靠它改数据重试
            return Task.FromResult(Envelopes.Invalid(Envelopes.Issue("payload.text", "缺少必填字段 text")));
        }

        return Task.FromResult(Envelopes.Valid());
    }

    /// <summary>插件体。</summary>
    public async Task<Envelope> HandleAsync(Envelope envelope, CancellationToken cancellationToken)
    {
        var payload = Envelopes.PayloadJson(envelope) ?? [];
        var text = payload.TryGetValue("text", out var raw) && raw is string s ? s : string.Empty;

        // 信封里的 trace / deadline / subject 会被中台透传，需要时可以直接读
        if (Envelopes.Budget(envelope) is { } budget && budget < MinBudget)
        {
            throw new InvalidOperationException($"剩余预算不足（{budget.TotalMilliseconds:0}ms），放弃处理");
        }

        // ---- HubState 演示：一个跨调用的调用计数 ----
        //
        // 插件实例**不保证**跨调用保留内存，所以这个计数放在中台的 HubState 里：
        // 插件重启、换副本，它都接着涨——这正是 HubState 存在的理由。
        //
        // 拿不到客户端时（还没注册上）整个调用照常进行，只是不带计数——这就是
        // fail-open：状态是**增强**，不该成为调用链路上的单点。
        // 不需要状态的插件把这一段删掉即可，别处一行都不用改。
        long? calls = null;
        var state = _state;
        if (state is not null)
        {
            try
            {
                var previous = 0L;
                var (value, found) = await state
                    .GetAsync("demo", "calls", cancellationToken)
                    .ConfigureAwait(false);
                if (found)
                {
                    // 值被人手改坏了不该让业务调用跟着失败，当没缓存处理
                    _ = long.TryParse(Encoding.UTF8.GetString(value), out previous);
                }

                var next = previous + 1;
                // ttl 传 TimeSpan.Zero = 不过期；粒度是秒，不足 1 秒会被截断为 0
                await state
                    .PutAsync("demo", "calls", Encoding.UTF8.GetBytes(next.ToString()), TimeSpan.Zero, cancellationToken)
                    .ConfigureAwait(false);
                calls = next;
            }
            catch (Exception ex) when (ex is HubStateException or RpcException)
            {
                // 本地能判定的（参数不合法）抛 HubStateException，中台判定的（凭证失效、
                // 后端故障）原样抛 RpcException——两种都当「这次没有状态」，业务结果照常返回
            }
        }

        var outPayload = new Dictionary<string, object?>
        {
            ["echo"] = "@@name@@ 收到: " + text,
            // 按**字节**算长度，与信封里的载荷编码口径一致：
            // 按字符算的话，"你好" 是 2 而字节是 6，两侧对不上的数字迟早要解释一遍
            ["length"] = Encoding.UTF8.GetByteCount(text),
        };
        if (calls is { } count)
        {
            outPayload["calls"] = count;
        }

        return Envelopes.WithPayloadJson(envelope, outPayload);
    }
}
