//! @@name@@ 的插件体。
//!
//! 它用 `google.protobuf.Struct` 承载 JSON 载荷：agent 经 MCP、外部系统经 HTTP
//! 调用本插件时，中台会把 JSON 对象包成 Struct 送进来，用
//! `@@sdk_module@@::envelope::payload_json` 取出来就是一个 `serde_json::Value`。
//!
//! 如果需要与其他插件在 flow 里传递**类型化**的业务消息，再加一份自己的 `.proto`、
//! 用 `build.rs` 生成 Rust 代码、在 `descriptor()` 里返回它的 FileDescriptorSet，
//! 并在 manifest 的 `produces` 中声明——那时 `Validate` 里改用
//! `@@sdk_module@@::envelope::payload_as` 解自己的类型。

use std::sync::{Arc, Mutex};
use std::time::Duration;

use @@sdk_module@@::envelope::{self, STRUCT_FQ_NAME};
use @@sdk_module@@::{Envelope, PluginError, PluginManifest, StateClient, ValidateResponse};

/// 继续处理所需的最小剩余预算。
///
/// 信封带着**绝对 deadline** 逐跳递减；预算不够时应当提前放弃，让失败快速冒泡，
/// 而不是把时间耗光后靠上层超时兜底——那样调用方连「为什么慢」都看不出来。
const MIN_BUDGET: Duration = Duration::from_millis(100);

/// @@name@@ 的实现。
///
/// 用 `Default::default()` 构造（即 `Plugin::default()`）——它只带一个空的
/// 状态槽，没有别的构造参数。
#[derive(Default)]
pub struct Plugin {
    /// 跨调用状态（HubState）的客户端，由骨架在**每次注册成功后**注入。
    ///
    /// 它是 `None` 就说明这个插件走的是无状态那一路——**用它之前必须判空**。
    /// 包在 `Mutex` 里是因为 [`Plugin::set_state`] 只拿得到 `&self`，
    /// 而注入的时机（注册循环那个任务）与 `handle` 执行的任务不是同一个。
    state: Mutex<Option<Arc<StateClient>>>,
}

impl Plugin {
    /// 取当前的状态客户端；`None` 表示还没注册上（或这个插件不用状态）。
    ///
    /// 返回 `Arc` 的克隆而不是持锁给引用：`MutexGuard` 不是 `Send`，
    /// 持着它跨 `.await` 会让整个 `handle` 编不过。
    fn state(&self) -> Option<Arc<StateClient>> {
        self.state.lock().ok()?.clone()
    }
}

#[@@sdk_module@@::async_trait]
impl @@sdk_module@@::Plugin for Plugin {
    /// 收到骨架注入的 HubState 客户端（本模板**已经接好了**）。
    ///
    /// # 什么时候需要它
    ///
    /// 插件实例**不保证**跨调用保留内存（热切换零代价、可水平扩展就是这么来的）。
    /// 要跨调用保留东西——登录缓存、去重标记、游标、限流计数——就得走 HubState。
    ///
    /// # 怎么用
    ///
    /// 在 [`Plugin::handle`] 里 `self.state()` 取出来用即可，**记得判空**：
    /// 取到 `None` 就说明还没注册上（骨架在注册成功后才注入），这时按 fail-open
    /// 处理——拿不到缓存就回源，别让一次状态抖动把业务调用带下水。
    ///
    /// ```ignore
    /// // 读。Ok(None) 是「没有这个键」，与「键在但值是空的」是两回事
    /// if let Some(v) = self.state().unwrap().get("sessions", user_id).await? {
    ///     // 命中
    /// }
    /// // 写。ttl 为 Duration::ZERO 表示不过期；粒度是**秒**，
    /// // 不足 1 秒会被截断成 0（= 永不过期），想让它过期就传 >= 1s
    /// self.state().unwrap().put("sessions", user_id, &blob, Duration::from_secs(1800)).await?;
    /// // 删。Ok(false) 表示这键本来就不存在，**不是**错误
    /// let existed = self.state().unwrap().delete("sessions", user_id).await?;
    /// // 扫。prefix 传 "" 表示扫整个命名空间；limit 必须在 1..=1000
    /// let entries = self.state().unwrap().scan("sessions", "user:", 100).await?;
    /// ```
    ///
    /// # 两个必须知道的约束
    ///
    /// - **命名空间是插件隔离的**：中台按注册凭证反查出你的插件名、强制拼进键前缀
    ///   （`hub:state:{插件名}:{namespace}:{key}`），你自报的 namespace 只是前缀下的
    ///   **子空间**。所以你只写自己的业务子空间（`sessions`、`cursors`），
    ///   既不需要也不应该写插件名。
    /// - **namespace / key / prefix 都只允许 `[A-Za-z0-9_.-]`、非空、最长 200 字节**。
    ///   放行 `*` 是漏洞不是功能：前缀靠字符串拼接，通配符会让 scan 变成跨命名空间的
    ///   模式匹配。
    ///
    /// 骨架在**每次注册成功后**都会再调一次（中台重启、实例被摘除后自愈），注入的
    /// 是**同一个** `Arc`，凭证在它内部轮换——不要把它拷走长期持有。
    ///
    /// 本地调试时 mock 中台也实现了这一套（键名规则与真中台同源），所以不必连真中台。
    fn set_state(&self, state: Arc<StateClient>) {
        if let Ok(mut slot) = self.state.lock() {
            *slot = Some(state);
        }
    }

    /// 声明插件的身份、契约与暴露给 agent 的能力。
    ///
    /// **同一版本号的 manifest 不可变更**——中台会拒绝「同号不同契约」的注册。
    /// 改了契约请升版本号。
    fn manifest(&self) -> PluginManifest {
        PluginManifest {
            name: "@@name@@".to_string(),
            version: "0.1.0".to_string(),
            description: "TODO: 一句话说明这个插件干什么".to_string(),
            owner: "TODO: 负责团队".to_string(),

            // 接受直接调用的 JSON 载荷。它是 well-known 类型，
            // 不必出现在自己的 proto 里，中台对 google.protobuf.* 有豁免。
            consumes: vec![@@sdk_module@@::proto::MessageContract {
                fq_name: STRUCT_FQ_NAME.to_string(),
                description: String::new(),
            }],

            // 暴露给 agent 的能力。它会聚合进中台统一的 MCP 工具面，名字是
            // `插件名__工具名`（跨插件重名不冲突）——注册成功后 agent 拉一次
            // tools/list 就能看见并调用，中台不用重启。
            //
            // 两条仍然成立的限制：**工具面变了不会主动通知已连接的 agent**
            // （`notifications/tools/list_changed` 未实现），所以 agent 要重新拉一次
            // 才看得见；插件实例被摘除后，它的工具也会随之从列表里消失。
            tools: vec![@@sdk_module@@::proto::ToolDecl {
                name: "echo".to_string(),
                description: "TODO: 这个工具干什么 —— agent 靠这句描述决定何时调用它"
                    .to_string(),
                input_schema_json:
                    r#"{"type":"object","properties":{"text":{"type":"string","description":"要回显的文本"}},"required":["text"]}"#
                        .to_string(),
                requires_approval: false,
            }],

            // 可调用的目标插件名（插件互调的权限名单）。**刻意不声明**：中台策略
            // HUB_PLUGIN_CALL_POLICY 为 allow（缺省）时不看这个名单，声明了反而
            // 把自己的调用面收窄；为 declared 时则必须声明，名单外一律拒绝。
            // 真要互调时打开下面这行（并同步升版本号——同版本号的 manifest 不可变更）：
            // invokes: vec!["目标插件名".to_string()],

            ..Default::default()
        }
    }

    /// 本插件的 proto 编译产物，中台据此建立契约基线并做字段级兼容检查。
    ///
    /// 只用 Struct 载荷的插件没有自己的 proto，**保持默认的空返回值即可**——
    /// 中台允许空 descriptor，只要 manifest 里没声明自有类型。
    /// （`hubkit` 的默认实现就是返回空，所以这里整个方法都可以不写。）
    // fn descriptor(&self) -> Vec<u8> { Vec::new() }

    /// 数据校验规则。
    ///
    /// 中台在把数据交给 `handle` 之前**一定**先调用它；返回 `valid = false` 时链路短路，
    /// `handle` 不会被调用。规则与插件体同版本发布，因此不可能与实现漂移。
    async fn validate(&self, envelope: &Envelope) -> Result<ValidateResponse, PluginError> {
        let Some(payload) = envelope::payload_json(envelope) else {
            return Ok(envelope::invalid(vec![envelope::issue(
                "payload",
                "需要 JSON 对象载荷",
            )]));
        };

        match payload.get("text").and_then(|v| v.as_str()) {
            None | Some("") => {
                // path 要能定位到具体字段，中台会原样把它回给调用方，
                // agent 靠它改数据重试
                Ok(envelope::invalid(vec![envelope::issue(
                    "payload.text",
                    "缺少必填字段 text",
                )]))
            }
            Some(_) => Ok(envelope::valid()),
        }
    }

    /// 插件体。
    async fn handle(&self, envelope: Envelope) -> Result<Envelope, PluginError> {
        let payload = envelope::payload_json(&envelope).unwrap_or_default();
        let text = payload
            .get("text")
            .and_then(|v| v.as_str())
            .unwrap_or_default();

        // 信封里的 trace / deadline / subject 由中台透传，需要时可以直接读
        if envelope::expired(&envelope) {
            return Err(PluginError::msg("信封已过截止时间，放弃处理"));
        }
        if let Some(budget) = envelope::budget(&envelope) {
            if budget < MIN_BUDGET {
                return Err(PluginError::msg(format!(
                    "剩余预算不足（{budget:?}），放弃处理"
                )));
            }
        }

        // ---- HubState 演示：一个跨调用的调用计数 ----
        //
        // 插件实例**不保证**跨调用保留内存，所以这个计数放在中台的 HubState 里：
        // 插件重启、换副本，它都接着涨——这正是 HubState 存在的理由。
        //
        // 这里刻意**不用 `?`**：状态调用失败（网络抖、凭证刚轮换）时业务结果照常
        // 返回，只是不带计数——这就是 fail-open：状态是**增强**，不该成为调用链路上
        // 的单点。拿不到客户端时（还没注册上）同理。
        // 不需要状态的插件把这一段删掉即可，别处一行都不用改。
        let mut calls = None;
        if let Some(state) = self.state() {
            let previous = state
                .get("demo", "calls")
                .await
                .ok()
                .flatten()
                .and_then(|raw| String::from_utf8(raw).ok())
                .and_then(|s| s.parse::<u64>().ok())
                .unwrap_or(0);
            let next = previous + 1;
            // ttl 传 Duration::ZERO = 不过期；粒度是秒，不足 1 秒会被截断成 0
            if state
                .put("demo", "calls", next.to_string().as_bytes(), Duration::ZERO)
                .await
                .is_ok()
            {
                calls = Some(next);
            }
        }

        let mut payload = serde_json::json!({
            "echo": format!("@@name@@ 收到: {text}"),
            "length": text.chars().count(),
        });
        if let Some(calls) = calls {
            payload["calls"] = serde_json::json!(calls);
        }

        let out = envelope::with_payload_json(&envelope, payload)?;
        Ok(out)
    }
}
