//! Command @@name@@ —— 一个 plugin-hub 插件。
//!
//! 中台与插件**不要求同机**；插件是独立进程，用 gRPC 与中台通信。
//! 启动时会向 `HUB_ADDR` 指定的中台自注册，并按中台指定的周期发心跳；
//! 被中台摘除后会自动重新注册，收到 SIGTERM / SIGINT 时会主动注销再退出。

/// 插件体。要改的通常只有这个文件。
mod plugin;

use hubkit::Config;

#[tokio::main]
async fn main() {
    // 配置全部来自环境变量：
    //   HUB_ADDR            中台插件面地址（必填）
    //   HUB_ADVERTISE_ADDR  中台可达的本插件地址（必填）
    //   HUB_LISTEN_ADDR     本插件监听地址（缺省 :9000）
    //   HUB_INSTANCE_ID     实例标识（缺省 主机名-PID）
    //   HUB_LOG_LEVEL       debug / info / warn / error
    let config = Config::from_env();

    // run 会一直跑到收到 SIGTERM / SIGINT，然后向中台注销、停掉 gRPC，再返回。
    if let Err(e) = hubkit::run(plugin::Plugin::default(), config).await {
        // 用 eprintln 而不是日志器：走到这里说明骨架已经拒绝了这次启动
        // （配置不全、manifest 有问题、端口被占），而错误本身必须被人看见——
        // 哪怕日志级别被调成了 error 以上。
        eprintln!("插件启动失败：{e}");
        std::process::exit(1);
    }
}
