# plugin-hub 环境变量示例
#
# 生产放置于部署目录下的 .env（不入 git，收紧文件权限），
# 由 docker compose --env-file 加载。全部变量都有缺省值，但
# PG_PASSWORD / REDIS_PASSWORD 必填。

# ---------- 监听 ----------
# HTTP 面（Ingress / Admin / MCP / 健康 / 指标）
# 生产固定 127.0.0.1：只经 nginx 的 /hub-api/ 路径前缀对外，与控制台同源
HUB_HTTP_HOST=127.0.0.1
HUB_HTTP_PORT=8095

# 插件面（注册 / 心跳 / 回调，gRPC）
# 必须绑 0.0.0.0：插件可能部署在其他主机上，要靠 nginx grpc_pass 转发进来
HUB_GRPC_HOST=0.0.0.0
HUB_GRPC_PORT=8093

# ---------- 主机面运维通道 ----------
# 管理面按设计是全插件化的（中台内不含鉴权逻辑），这条 unix socket 是鉴权插件
# 坏掉时唯一的逃生口。信任边界是文件系统权限，因此路径要落在只有 root 能访问的目录。
# 容器内用 docker exec <container> hubctl status 调用。
HUB_OPS_SOCKET=/run/plugin-hub/ops.sock

# ---------- 依赖（由 deploy/docker-compose.yml 自带）----------
#
# 这里只给**分量**，DATABASE_URL / REDIS_URL 由 compose 拼出来——密码因此
# 只此一处，不会出现「改了 PG_PASSWORD 却忘了同步连接串里那份」这种事。
# （代价：不能再在 .env 里写连接串覆盖它。要指向外部 PG，改 compose 里
#   hub 的 DATABASE_URL 那一行。）
#
# 端口刻意避开默认值：不与同机其它服务相争，也一眼看得出这个库归谁。
PG_USER=plugin_hub
# 必填。**只写在这个文件里，不进仓库。**
#
# ⚠️ 用**纯字母数字**，推荐直接生成一个十六进制的：
#
#     openssl rand -hex 24
#
# 原因是这个密码会被**原样拼进 DATABASE_URL**（见 compose 里那一行），而 URL 有
# 自己的保留字符：密码里出现 `/` `#` `?` 会让连接串解析失败——中台启动即报
# `invalid port number`，那个报错完全指不到「密码里有斜杠」；出现单个 `$`
# 更阴，compose 会把它当变量插值吞掉，于是库和连接串**一致地**用了截断后的
# 密码，等到有人拿 .env 原文去 psql 才发现对不上。
# （`openssl rand -base64` 生成的密码约 38% 会含 `/`，别用。）
PG_PASSWORD=
PG_DB=plugin_hub
PG_PORT=55432

# 自带 Redis 的密码。**同样必须给**——端口映射挡不住同机其它进程，
# 任何本机进程都能连上来读写中台的总线消息与状态 KV，密码补的就是这一层。
# 字符限制与 PG_PASSWORD 相同（它也要被拼进 REDIS_URL）：用 `openssl rand -hex 24`。
REDIS_PASSWORD=
REDIS_PORT=56380

# 数据目录（相对 compose 文件所在目录或绝对路径均可）
PG_DATA_DIR=./data/pg
REDIS_DATA_DIR=./data/redis

# ---------- 日志 ----------
LOG_LEVEL=info

# ---------- 插件注册 ----------
# 跨机插件的**可达地址**（中台回拨插件时用）。插件自注册时上报自己的地址，
# 中台注册时即做可达性探测，探不通直接拒绝——避免「注册成功但永远调不通」。
# 插件在本机跑时不用配；在容器/其他主机上跑时配成外部可见地址，
# 形如 https://hub.example.com:8094。
HUB_PLUGIN_PUBLIC_ADDR=

# ---------- MCP 工具面 ----------
# DNS rebinding 防护：允许的 Host 白名单，逗号分隔。
# 默认空 = 仅回环（本地开发够用）；**经 nginx 对外必须配置**，
# 一旦配置即替换默认回环放行，回环要显式列出：
#   HUB_MCP_ALLOWED_HOSTS=hub.example.com,203.0.113.10,127.0.0.1
# 若返回 403 Forbidden: Host header is not allowed，把客户端使用的 Host 加进来。
HUB_MCP_ALLOWED_HOSTS=
# 登录闸门：配了 HUB_AUTH_PLUGIN 后，未携带登录态的 MCP 调用会收到
# 「需要登录」的指引卡而不是直接放行。留空不启用。
HUB_MCP_LOGIN_GATE=
# 对外公布的 MCP 端点（写进登录闸门指引卡里），形如 https://hub.example.com/mcp
HUB_MCP_PUBLIC_ENDPOINT=
# 嵌入场景的传输层开关：逗号分隔的 Origin 白名单（协议+域名+端口精确匹配）。
# 嵌入方前端与 hub 跨 origin 时浏览器要求服务端应答 CORS 头，带 Cookie 的
# 跨域 fetch 才放行。留空 = 不挂 CORS 层（同域反代部署零行为变化）。
# 刻意不支持 `*`：带凭证的 CORS 禁止通配 Origin，而嵌入要带的正是 Cookie。
HUB_CORS_ALLOWED_ORIGINS=

# ---------- 管理面鉴权 ----------
# 承担管理面鉴权的插件名（如 auth）。中台只认权限位（hub:read/invoke/edit/publish/admin），
# 「这个凭证有哪几个权限位」由该插件回答。启用前提是插件已部署，
# 否则管理面谁都进不去——这是设计（fail-closed），不是故障。
HUB_AUTH_PLUGIN=
HUB_AUTH_PLUGIN_VERSION=

# ---------- 首次配置引导 ----------
# 中台完全空白时的引导凭据（配置鉴权插件用），留空不启用。
BOOTSTRAP_TOKEN=

# ---------- 可观测 ----------
# span 已自存 PostgreSQL，这里只是顺便推给外部 trace 后端（OTLP/HTTP）。
OTLP_ENDPOINT=

# ---------- 运行时调优（默认即合理值，压测后按需调整）----------
# 实例级治理：每实例并发上限、熔断
NODE_MAX_CONCURRENCY=32
NODE_QUEUE_TIMEOUT_MS=100
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECS=10
# 插件互调授权：留空 = 不限制；JSON 对象 = 插件名 → 允许调用的插件列表
HUB_PLUGIN_CALL_POLICY=

# 异步总线：Redis Stream 消费组
ASYNC_WORKERS=4
BUS_MAX_DEPTH=100000
BUS_MAX_DELIVERY=5
BUS_CLAIM_MIN_IDLE_SECS=60
STREAM_RETENTION_HOURS=24

# 数据留存
SPAN_RETENTION_DAYS=7
RUN_RETENTION_DAYS=90
REJECTION_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=90
