package main

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"@@sdk_module@@/hubkit"
	"@@sdk_module@@/proto/hubv1"
)

// minBudget 是继续处理所需的最小剩余预算。
//
// 信封带着绝对 deadline 逐跳递减；预算不够时应当提前放弃，让失败快速冒泡，
// 而不是把时间耗光后靠上层超时兜底——那样调用方连"为什么慢"都看不出来。
const minBudget = 100 * time.Millisecond

// Plugin 是 @@name@@ 的实现。
//
// 它用 google.protobuf.Struct 承载 JSON 载荷：agent 经 MCP、外部系统经 HTTP
// 调用本插件时，中台会把 JSON 对象包成 Struct 送进来，用 hubkit.PayloadJSON 取。
//
// 如果需要与其他插件在 flow 里传递**类型化**的业务消息，再加一份自己的 .proto、
// 用 protoc 生成 Go 代码、在 Descriptor() 里返回它，并在 manifest 的 produces 中声明。
type Plugin struct {
	// state 是跨调用状态（HubState）的客户端，由 hubkit 在**每次注册成功后**注入。
	//
	// 它是 nil 就说明这个插件走的是无状态那一路——**用它之前必须判空**。
	// 本模板已经接好了注入（见 [`SetState`]），并且 Handle 里有个真的在用的例子
	// （一个跨调用的调用计数）。
	state *hubkit.StateClient
}

// NewPlugin 构造插件。
func NewPlugin() *Plugin { return &Plugin{} }

// SetState 由 hubkit 在注册成功后调用，把状态客户端交进来。
//
// # 什么时候需要它
//
// 插件实例**不保证**跨调用保留内存（热切换零代价、可水平扩展就是这么来的）。
// 要跨调用保留东西——登录缓存、去重标记、游标、限流计数——就得走 HubState。
//
// # 怎么用
//
// 本模板**已经接好了**，而且 [`Plugin.Handle`] 里有一个真的在用的例子（跨调用计数）
// ——**记得判空**：谁把 SetState 删了，state 就是 nil，插件回到无状态那一路。
//
//	// 读。第二个返回值区分「没有这个键」与「键在但值是空的」
//	if v, found, err := p.state.Get(ctx, "sessions", userID); err == nil && found {
//		// 命中
//	}
//	// 写。ttl 传 0 表示不过期；**负数会被拒绝**（注意别写成 time.Duration(0) 之外的负值）
//	err := p.state.Put(ctx, "sessions", userID, blob, 30*time.Minute)
//	// 删。返回它之前是否存在
//	existed, err := p.state.Delete(ctx, "sessions", userID)
//	// 扫。prefix 传空串表示扫整个命名空间，limit 上限 1000
//	entries, err := p.state.Scan(ctx, "sessions", "user:", 100)
//
// # 两个必须知道的约束
//
//   - **命名空间是插件隔离的**：中台按注册凭证反查出你的插件名、强制拼进键前缀，
//     你自报的 namespace 只是前缀下的**子空间**。所以你只写自己的业务子空间
//     （`sessions`、`cursors`），既不需要也不应该写插件名。
//   - **键名只允许 `[A-Za-z0-9_.-]`，非空，最长 200 字节**。放行 `*` 是漏洞不是功能：
//     前缀靠字符串拼接，通配符会让 Scan 变成跨命名空间的模式匹配。
//
// 本地调试时 mock 中台也实现了这一套（键名规则与真中台同源），所以不必连真中台。
func (p *Plugin) SetState(s *hubkit.StateClient) {
	p.state = s
}

// Manifest 声明插件的身份、契约与暴露给 agent 的能力。
//
// 同一版本号的 manifest 不可变更——中台会拒绝「同号不同契约」的注册，改了请升版本号。
func (p *Plugin) Manifest() *hubv1.PluginManifest {
	return &hubv1.PluginManifest{
		Name:        "@@name@@",
		Version:     "0.1.0",
		Description: "TODO: 一句话说明这个插件干什么",
		Owner:       "TODO: 负责团队",

		// 接受直接调用的 JSON 载荷。它是 well-known 类型，不必出现在自己的 proto 里。
		Consumes: []*hubv1.MessageContract{
			{FqName: hubkit.StructFQName},
		},

		// 暴露给 agent 的能力。它会聚合进中台统一的 MCP 工具面，名字是
		// `插件名__工具名`（跨插件重名不冲突）——注册成功后 agent 拉一次
		// tools/list 就能看见并调用，中台不用重启。
		//
		// 两条仍然成立的限制：**工具面变了不会主动通知已连接的 agent**
		// （`notifications/tools/list_changed` 未实现），所以 agent 要重新拉一次
		// 才看得见；插件实例被摘除后，它的工具也会随之从列表里消失。
		Tools: []*hubv1.ToolDecl{
			{
				Name:            "echo",
				Description:     "TODO: 这个工具干什么 —— agent 靠这句描述决定何时调用它",
				InputSchemaJson: `{"type":"object","properties":{"text":{"type":"string","description":"要回显的文本"}},"required":["text"]}`,
			},
		},
	}
}

// Descriptor 返回本插件的 proto 编译产物，中台据此建立契约基线并做字段级兼容检查。
//
// 只用 Struct 载荷的插件没有自己的 proto，返回空即可——中台允许空 descriptor，
// 只要 manifest 里没声明自有类型。
func (p *Plugin) Descriptor() []byte {
	return hubkit.DescriptorOf()
}

// Validate 是数据校验规则。
//
// 中台在把数据交给 Handle 之前**一定**先调用它；返回 Valid=false 时链路短路，
// Handle 不会被调用。规则与插件体同版本发布，因此不可能与实现漂移。
func (p *Plugin) Validate(_ context.Context, env *hubv1.Envelope) (*hubv1.ValidateResponse, error) {
	payload, ok := hubkit.PayloadJSON(env)
	if !ok {
		return hubkit.Invalid(hubkit.Issue("payload", "需要 JSON 对象载荷")), nil
	}

	text, ok := payload["text"].(string)
	if !ok || text == "" {
		// path 要能定位到具体字段，中台会原样把它回给调用方，agent 靠它改数据重试
		return hubkit.Invalid(hubkit.Issue("payload.text", "缺少必填字段 text")), nil
	}

	return hubkit.Valid(), nil
}

// Handle 是插件体。
func (p *Plugin) Handle(ctx context.Context, env *hubv1.Envelope) (*hubv1.Envelope, error) {
	payload, _ := hubkit.PayloadJSON(env)
	text, _ := payload["text"].(string)

	// envelope 里的 trace/deadline/subject 会被中台透传，需要时可以直接读
	if budget, ok := hubkit.Budget(env); ok && budget < minBudget {
		return nil, fmt.Errorf("剩余预算不足（%s），放弃处理", budget)
	}

	// ---- HubState 演示：一个跨调用的调用计数 ----
	//
	// 插件实例**不保证**跨调用保留内存，所以这个计数放在中台的 HubState 里：
	// 插件重启、换副本，它都接着涨——这正是 HubState 存在的理由。
	//
	// 拿不到客户端（还没注册上）或状态调用失败时，整个调用照常进行、只是不带计数
	// ——这就是 fail-open：状态是**增强**，不该成为调用链路上的单点。
	// 不需要状态的插件把这一段删掉即可，别处一行都不用改。
	var calls int64
	recorded := false
	if p.state != nil {
		var previous int64
		if raw, found, err := p.state.Get(ctx, "demo", "calls"); err == nil && found {
			// 值被人手改坏了不该让业务调用跟着失败，parse 不出来的话就从头数
			previous, _ = strconv.ParseInt(string(raw), 10, 64)
		}
		calls = previous + 1
		// ttl 传 0 表示不过期；粒度是秒，**负数会被拒绝**
		recorded = p.state.Put(ctx, "demo", "calls", []byte(strconv.FormatInt(calls, 10)), 0) == nil
	}

	out := map[string]any{
		"echo":   fmt.Sprintf("@@name@@ 收到: %s", text),
		"length": len(text),
	}
	if recorded {
		out["calls"] = calls
	}
	return hubkit.WithPayloadJSON(env, out)
}
